<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="560.0" prefWidth="1120.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="trioparadadura.example.manedeliveryfx.controller.GerenciarPedidosController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: gray;">
         <padding>
            <Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
         </padding>
         <children>
            <Label minWidth="-Infinity" text="De" textFill="WHITE"><font><Font name="System Bold" size="12.0" /></font></Label>
            <DatePicker fx:id="dpInicio" prefWidth="130.0" />
            <Label minWidth="-Infinity" text="Até" textFill="WHITE"><font><Font name="System Bold" size="12.0" /></font></Label>
            <DatePicker fx:id="dpFim" prefWidth="130.0" />
            <Label minWidth="-Infinity" text="Status" textFill="WHITE"><font><Font name="System Bold" size="12.0" /></font></Label>
            <ComboBox fx:id="cbStatus" prefWidth="170.0" promptText="Todos" />
            <Button mnemonicParsing="false" onAction="#onFiltrar" text="Filtrar" />
            <Button mnemonicParsing="false" onAction="#onLimpar" text="Limpar" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onDetalhes" style="-fx-background-color: black;" text="Detalhes" textFill="WHITE" />
            <Button mnemonicParsing="false" onAction="#onImprimir" style="-fx-background-color: black;" text="PDF" textFill="WHITE" />
            <Button mnemonicParsing="false" onAction="#onAtualizarStatus" style="-fx-background-color: royalblue;" text="Atualizar status" textFill="WHITE" />
            <Button mnemonicParsing="false" onAction="#onApagar" style="-fx-background-color: salmon;" text="Apagar" textFill="WHITE" />
         </children>
      </HBox>
      <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="coId" maxWidth="60.0" prefWidth="50.0" style="-fx-alignment: CENTER;" text="Nº" />
            <TableColumn fx:id="coData" maxWidth="110.0" prefWidth="95.0" style="-fx-alignment: CENTER;" text="DATA" />
            <TableColumn fx:id="coCliente" prefWidth="200.0" text="CLIENTE" />
            <TableColumn fx:id="coTelefone" prefWidth="130.0" text="TELEFONE" />
            <TableColumn fx:id="coPagamento" prefWidth="120.0" text="PAGAMENTO" />
            <TableColumn fx:id="coStatus" prefWidth="160.0" text="STATUS" />
            <TableColumn fx:id="coTotal" maxWidth="120.0" prefWidth="100.0" style="-fx-alignment: CENTER-RIGHT;" text="TOTAL R$" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_RIGHT" style="-fx-background-color: #e6e6e6;">
         <padding>
            <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
         </padding>
         <children>
            <Label fx:id="lbResumo" text="0 pedidos">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
         </children>
      </HBox>
   </children>
</VBox>
