<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="trioparadadura.example.manedeliveryfx.controller.ProdutoFormController">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
    </padding>
    <children>
        <Label text="Nome" />
        <TextField fx:id="tfNome" />
        <HBox spacing="12.0">
            <children>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Preço R$" />
                        <TextField fx:id="tfPreco" />
                    </children>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Volume (ml)" />
                        <TextField fx:id="tfVolume" />
                    </children>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Estoque" />
                        <TextField fx:id="tfEstoque" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <Label text="Categoria" />
        <ComboBox fx:id="cbCategoria" maxWidth="1.7976931348623157E308" />
        <Label text="Marca" />
        <ComboBox fx:id="cbMarca" maxWidth="1.7976931348623157E308" />
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <children>
                <Button onAction="#onCancelar" text="Cancelar" />
                <Button defaultButton="true" onAction="#onSalvar" text="Salvar" />
            </children>
        </HBox>
    </children>
</VBox>