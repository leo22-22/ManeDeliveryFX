<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="420.0" spacing="8.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="trioparadadura.example.manedeliveryfx.controller.StatusFormController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <children>
      <Label text="Descrição" />
      <TextField fx:id="tfDescricao" />
      <Label text="Observação" />
      <TextField fx:id="tfObservacao" />
      <CheckBox fx:id="ckSucesso" text="Pedido concluído com sucesso">
         <VBox.margin>
            <Insets top="6.0" />
         </VBox.margin>
      </CheckBox>
      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onCancelar" prefWidth="90.0" text="Cancelar" />
            <Button defaultButton="true" mnemonicParsing="false" onAction="#onSalvar" prefWidth="90.0" text="Salvar" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
