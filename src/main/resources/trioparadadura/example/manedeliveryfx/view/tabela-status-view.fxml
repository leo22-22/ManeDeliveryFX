<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="491.0" prefWidth="818.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="trioparadadura.example.manedeliveryfx.controller.TabelaStatusController">
   <children>
      <HBox alignment="CENTER_RIGHT" prefHeight="57.0" prefWidth="818.0" spacing="16.0" style="-fx-background-color: gray;">
         <children>
            <Button mnemonicParsing="false" onAction="#onNovoStatus" prefHeight="32.0" prefWidth="34.0" style="-fx-background-color: black;" text="+" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#onApagarStatus" prefHeight="32.0" prefWidth="34.0" style="-fx-background-color: salmon;" text="-" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#onAlterarStatus" prefHeight="34.0" prefWidth="34.0" style="-fx-background-color: royalblue;" text="..." textFill="WHITE">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets right="16.0" />
         </padding>
      </HBox>
      <TableView fx:id="tableView" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="coId" maxWidth="50.0" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="coDescricao" prefWidth="180.0" text="DESCRIÇÃO" />
          <TableColumn fx:id="coObservacao" prefWidth="350.0" text="OBSERVAÇÃO" />
          <TableColumn fx:id="coSucesso" maxWidth="90.0" prefWidth="90.0" text="SUCESSO" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
