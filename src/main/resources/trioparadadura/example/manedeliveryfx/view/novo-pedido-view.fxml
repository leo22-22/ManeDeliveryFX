<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="640.0" prefWidth="880.0" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="trioparadadura.example.manedeliveryfx.controller.NovoPedidoController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <!-- Dados do pedido -->
      <VBox spacing="8.0" style="-fx-border-color: #b5b5b5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: white;">
         <padding>
            <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
         </padding>
         <children>
            <HBox spacing="12.0">
               <children>
                  <VBox spacing="3.0">
                     <children>
                        <Label text="ID"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <TextField fx:id="tfId" disable="true" prefWidth="50.0" />
                     </children>
                  </VBox>
                  <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Nome do cliente"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <TextField fx:id="tfNome" />
                     </children>
                  </VBox>
                  <VBox spacing="3.0">
                     <children>
                        <Label text="Data"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <DatePicker fx:id="dpData" prefWidth="160.0" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox spacing="12.0">
               <children>
                  <VBox spacing="3.0">
                     <children>
                        <Label text="Cep"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <TextField fx:id="tfCep" onAction="#onBuscarCep" prefWidth="135.0" promptText="00000-000" />
                     </children>
                  </VBox>
                  <VBox spacing="3.0">
                     <children>
                        <Label text="Nº da Casa"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <TextField fx:id="tfNumero" prefWidth="100.0" />
                     </children>
                  </VBox>
                  <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Localização"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <TextField fx:id="tfLocal" editable="false" promptText="Preenchida automaticamente pelo CEP" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="BOTTOM_LEFT" spacing="12.0">
               <children>
                  <VBox spacing="3.0">
                     <children>
                        <Label text="Telefone"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <TextField fx:id="tfTelefone" prefWidth="250.0" promptText="(18) 99999-9999" />
                     </children>
                  </VBox>
                  <VBox spacing="3.0">
                     <children>
                        <Label text="Tipo Pagamento"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <ComboBox fx:id="cbTipoPagamento" prefWidth="170.0" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <VBox alignment="BOTTOM_RIGHT" spacing="0.0">
                     <children>
                        <Label text="Valor do pedido R$"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <Label fx:id="lbTotal" text="0,00" textFill="#5b1fd1"><font><Font name="System Bold" size="26.0" /></font></Label>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <!-- Itens do pedido -->
      <VBox style="-fx-border-color: #b5b5b5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: #b8b8b8;" VBox.vgrow="ALWAYS">
         <children>
            <HBox fx:id="hbAdicionar" alignment="CENTER" spacing="12.0">
               <padding>
                  <Insets bottom="8.0" left="40.0" right="40.0" top="8.0" />
               </padding>
               <children>
                  <ComboBox fx:id="cbProduto" maxWidth="1.7976931348623157E308" promptText="Selecione o produto" HBox.hgrow="ALWAYS" />
                  <Spinner fx:id="spQuantidade" editable="true" prefWidth="80.0" />
                  <Button mnemonicParsing="false" onAction="#onAdicionarItem" prefWidth="34.0" text="+" />
                  <Button mnemonicParsing="false" onAction="#onRemoverItem" prefWidth="34.0" text="-" />
               </children>
            </HBox>
            <TableView fx:id="tvItens" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="coProduto" prefWidth="400.0" text="PRODUTO" />
                  <TableColumn fx:id="coQuantidade" maxWidth="110.0" prefWidth="100.0" style="-fx-alignment: CENTER;" text="QUANTIDADE" />
                  <TableColumn fx:id="coPreco" maxWidth="110.0" prefWidth="100.0" style="-fx-alignment: CENTER-RIGHT;" text="PREÇO R$" />
                  <TableColumn fx:id="coTotal" maxWidth="110.0" prefWidth="100.0" style="-fx-alignment: CENTER-RIGHT;" text="TOTAL R$" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER" spacing="60.0">
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
               <children>
                  <Button fx:id="btConfirmar" mnemonicParsing="false" onAction="#onConfirmar" prefHeight="32.0" prefWidth="140.0" text="Confirmar" />
                  <Button fx:id="btCancelar" mnemonicParsing="false" onAction="#onCancelar" prefHeight="32.0" prefWidth="140.0" text="Cancelar" />
                  <Button fx:id="btImprimir" disable="true" mnemonicParsing="false" onAction="#onImprimir" prefHeight="32.0" prefWidth="140.0" text="Imprimir" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
